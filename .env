# Port the app is exposed on (nginx)
APP_PORT=8080
 
# Gunicorn workers (auto-tuned if left empty)
GUNICORN_WORKERS=3
 
# Django
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
 
# Path on the HOST where report JSON files are dropped.
# The file watcher will trigger `manage.py update` on new/modified files.
REPORTS_DIR=./data/reports
 
# How often (in seconds) the watcher polls for new files
WATCH_POLL_INTERVAL=5
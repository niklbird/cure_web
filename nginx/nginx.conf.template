server {
    listen 80;
    server_name _;

    # ── Vue SPA ──────────────────────────────────────────────────────────
    root /usr/share/nginx/html/app;
    index index.html;

    # Include standard MIME types
    include /etc/nginx/mime.types;

    # Serve the WASM file with the correct MIME type
    types {
        application/wasm wasm;
    }

    # SPA fallback — any path that doesn't match a file gets index.html
    location ${APP_BASE_PATH}/ {
        alias /usr/share/nginx/html/app/;
        try_files $uri $uri/ /index.html;
    }

    # ── Cache policy for frontend assets ─────────────────────────────────
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|wasm)$ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # ── Gzip ─────────────────────────────────────────────────────────────
    gzip on;
    gzip_types
        text/plain
        text/css
        application/json
        application/javascript
        text/xml
        application/xml
        application/wasm
        image/svg+xml;
    gzip_min_length 256;
}